# Image pins - set any to a specific tag, digest, or commit-tagged image.
POSTGRES_IMAGE=postgres:16-bookworm@sha256:efedf3595f1d6f415c08568ba171029bf54052e754cc9f030e3f2412b21f3d67
# Locally built images (override to pull a prebuilt commit image instead):
WEB_IMAGE=zipherscan-web:local
API_IMAGE=zipherscan-api:local
# Build args for the locally built images:
NODE_IMAGE=node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
GIT_COMMIT=unknown

# ZSA node the API and web read from.
ZEBRA_RPC_URL=https://rpc.test-zsa.org

# Database credentials
DB_NAME=zcash_explorer
DB_USER=zcash_user
DB_PASSWORD=changeme
POSTGRES_ADMIN_PASSWORD=postgres-local-only

# Public-facing URLs (as reached from the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
WEB_PORT=3000
API_PORT=3001

# API list-response cache (in-process).
API_LIST_CACHE_ENABLED=0
API_CACHE_NAMESPACE=zsa1
API_LIST_CACHE_MAX_ENTRIES=1000

# Adjacent Rust indexer checkout used for the canonical schema/migrations.
CIPHERSCAN_RUST_DIR=../cipherscan-rust
